# Copy to .env and fill in. Everything has a safe local default except where marked REQUIRED IN PRODUCTION.

NODE_ENV=development
PORT=4000
# all | comma list of: users,products,cart,payments   (run several processes later by splitting this)
SERVICES=all
RUN_WORKERS=true

# Postgres (docker compose up -d gives you this one)
DATABASE_URL=postgres://aribas:aribas@127.0.0.1:5432/aribas
# true for hosted Postgres (Render, Neon, Supabase…)
DATABASE_SSL=false

# Storefront origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173
# REQUIRED IN PRODUCTION: long random strings.  Generate:  openssl rand -base64 48
JWT_SECRET=
INTERNAL_TOKEN=
# Phone numbers that become admins when they log in
ADMIN_PHONES=

# ── Payments ──  mock (local) | razorpay
PAYMENT_PROVIDER=mock
# Razorpay Dashboard → Account & Settings → API Keys (use rzp_test_… keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → secret you set there. URL: https://<api-host>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp ──  console (prints messages, shows OTP in the API response locally) | meta
WHATSAPP_PROVIDER=console
# Meta for Developers → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en
# Template names as approved in WhatsApp Manager (see README → WhatsApp templates)
WHATSAPP_OTP_TEMPLATE=aribas_login_otp
WHATSAPP_RECEIPT_TEMPLATE=aribas_order_receipt
# Optional; leave empty to skip these messages
WHATSAPP_REFUND_TEMPLATE=
WHATSAPP_SHIPPED_TEMPLATE=

# ── Business details printed on receipts ──
BUSINESS_NAME=Aribas
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=
SITE_URL=https://ariba-collections.onrender.com

# ── Rules (defaults shown) ──
ORDER_HOLD_MINUTES=30
RETURN_WINDOW_DAYS=7
SHIPPING_FREE_ABOVE=1999
SHIPPING_STANDARD_FEE=99
SHIPPING_EXPRESS_FEE=199
